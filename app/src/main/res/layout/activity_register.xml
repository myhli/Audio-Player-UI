<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:fontFamily="monospace"
        android:text="Register"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textStyle="bold" />

    .

    <ImageView
        android:layout_gravity="center"
        android:layout_width="200dp"
        android:layout_height="190dp"
        android:src="@drawable/logo" />

    <EditText
        android:id="@+id/regisnama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="input nama . . ." />

    <EditText
        android:id="@+id/regispassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="input password . . ."
        android:inputType="textPassword"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="confirmation password . . ."
        android:inputType="textPassword"/>

    <EditText
        android:id="@+id/regisemail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="input email . . ."
        android:inputType="textEmailAddress"/>

    <EditText
        android:id="@+id/regisalamat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="input alamat . . ." />

    <EditText
        android:id="@+id/regisnowa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="input nomor wa . . ."
        android:inputType="number"
        android:maxLength="13"/>


    <Button
        android:id="@+id/regisbutton"
        android:backgroundTint="#d1bc8e"
        android:text="Create Account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
